.package {
	type 0 : integer
	session 1 : integer
}

rpc_heartbeat 1 {
	response {
		time 0 : integer
	}
}

rpc_ping 2 {
	request {
		msg 0 : string
	}
	response {
		msg 0 : string
	}
}

rpc_echo 3 {
	request {
		content 0 : string
	}
	response {
		content 0 : string
	}
}

rpc_get_user_info 4 {
	response {
		userid 0 : string
		subid 1 : string
		login_time 2 : integer
	}
}

rpc_add_item 5 {
	request {
		id 0 : integer
		name 1 : string
	}
	response {
		ok 0 : integer
	}
}

rpc_get_inventory 6 {
	response {
		count 0 : integer
	}
}

rpc_change_nickname 7 {
	request {
		name 0 : string
	}
}